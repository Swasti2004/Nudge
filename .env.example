# ============================================================================
# Nudge Copilot - Environment Configuration Template
# ============================================================================
# Copy this file to .env for local development or set these variables
# in your hosting dashboard (e.g. Railway, Render).
# NEVER commit your actual .env file or credentials to Git!

# ----------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ----------------------------------------------------------------------------
# 2. SQLite Database Path (Persistent Storage)
# ----------------------------------------------------------------------------
# Local development default: ./data/nudge.db
# On Railway with an attached volume mounted at /data:
DATABASE_PATH=/data/nudge.db

# ----------------------------------------------------------------------------
# 3. Google Gemma 4 API Configuration
# ----------------------------------------------------------------------------
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Recommended Gemma 4 Model Identifier
GEMMA_MODEL=gemma-4-26b-a4b-it

# AI Execution Mode:
# 'production' - executes genuine live Gemma 4 inference calls
# 'mock'       - uses local deterministic heuristic fallback (no external API calls)
AI_MODE=production

# ----------------------------------------------------------------------------
# 4. Web Push Notification Keys (VAPID)
# ----------------------------------------------------------------------------
# Generate your own pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@nudge.local
